{
  "name": "protonmail-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A local MCP server for Proton Mail Bridge.",
  "license": "MIT",
  "bin": {
    "protonmail-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "start": "bun run src/index.ts",
    "test": "vp test",
    "check": "vp check",
    "inspect": "bunx @modelcontextprotocol/inspector bun run src/index.ts"
  },
  "dependencies": {
    "@hyzyla/pdfium": "3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "html-to-text": "10.0.0",
    "imapflow": "^1.5.0",
    "jpeg-js": "^0.4.4",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "pngjs": "^7.0.0",
    "proper-lockfile": "^4.1.2",
    "unpdf": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pngjs": "^6.0.5",
    "@types/proper-lockfile": "^4.1.4",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "^0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
