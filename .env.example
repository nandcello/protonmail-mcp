# Copy this file to .env, then replace the placeholder credentials and sender.
PROTON_BRIDGE_USERNAME=bridge-username
PROTON_BRIDGE_PASSWORD=bridge-password
PROTON_DEFAULT_FROM=you@proton.me
PROTON_ALLOWED_SENDERS=you@proton.me,your-alias@example.com

# Proton Mail Bridge defaults for its loopback-only services.
PROTON_BRIDGE_HOST=127.0.0.1
PROTON_BRIDGE_IMAP_PORT=1143
PROTON_BRIDGE_SMTP_PORT=1025
PROTON_BRIDGE_SECURITY=starttls
PROTON_BRIDGE_TLS_REJECT_UNAUTHORIZED=false

# Optional: to enable strict TLS verification, set the flag above to true and
# uncomment the path to Bridge's exported certificate.
# PROTON_BRIDGE_CA_FILE=/absolute/path/to/bridge-certificate.pem

# Refuse to parse messages larger than 25 MiB.
PROTON_MAX_MESSAGE_BYTES=26214400

# Concurrent IMAP sessions to Bridge per process, and how long extra requests
# wait for one before failing with a "busy" error.
# PROTON_IMAP_MAX_CONNECTIONS=3
# PROTON_IMAP_QUEUE_TIMEOUT_MS=45000

# Optional: absolute directory where get_email_attachment may save files
# (saveToFile=true). Saving is refused when unset.
# PROTON_ATTACHMENT_DIR=/absolute/path/to/attachments

# Optional: comma-separated opaque IDs for inbox notification consumers.
# A subscription may only target an ID configured here.
# PROTON_INBOX_CONSUMERS=desktop-notifier,build-alerts

# Optional: persistent configuration for inbox notification subscriptions.
# Notifications stay off until a subscription is explicitly created.
# PROTON_INBOX_SUBSCRIPTIONS_FILE=/absolute/path/to/inbox-subscriptions.json
